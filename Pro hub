--──────────────── mục accordion ────────────────
local function createSection(parent, titleText, layoutOrder)
	local section = new("Frame", {
		Size = UDim2.new(1, 0, 0, 0),
		BackgroundTransparency = 1,
		LayoutOrder = layoutOrder,
		AutomaticSize = Enum.AutomaticSize.Y,
	}, parent)
	new("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder }, section)
	new("UIPadding", { PaddingTop = UDim.new(0, 4), PaddingBottom = UDim.new(0, 4) }, section)

	local header = new("TextButton", {
		Size = UDim2.new(1, 0, 0, 34),
		BackgroundColor3 = Color3.fromRGB(32, 34, 44),
		Text = "",
		AutoButtonColor = false,
		BorderSizePixel = 0,
		LayoutOrder = 1,
	}, section)
	new("UICorner", { CornerRadius = UDim.new(0, 8) }, header)

	new("TextLabel", {
		Size = UDim2.new(1, -40, 1, 0),
		Position = UDim2.new(0, 12, 0, 0),
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBold,
		TextSize = 13,
		TextColor3 = Color3.fromRGB(120, 180, 255),
		TextXAlignment = Enum.TextXAlignment.Left,
		Text = titleText,
	}, header)

	local arrow = new("TextLabel", {
		Size = UDim2.new(0, 20, 1, 0),
		Position = UDim2.new(1, -28, 0, 0),
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBold,
		TextSize = 13,
		TextColor3 = Color3.fromRGB(160, 165, 180),
		Text = "▸",
	}, header)

	local body = new("Frame", {
		Size = UDim2.new(1, 0, 0, 0),
		BackgroundTransparency = 1,
		LayoutOrder = 2,
		Visible = false,
		AutomaticSize = Enum.AutomaticSize.Y,
	}, section)
	new("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }, body)
	new("UIPadding", { PaddingTop = UDim.new(0, 8), PaddingBottom = UDim.new(0, 4) }, body)

	header.MouseButton1Click:Connect(function()
		body.Visible = not body.Visible
		arrow.Text = body.Visible and "▾" or "▸"
	end)

	return body
end

--──────────────── slider ────────────────
local function createSlider(parent, labelText, minValue, maxValue, defaultValue, onChanged, layoutOrder)
	local row = new("Frame", {
		Size = UDim2.new(1, 0, 0, 46),
		BackgroundTransparency = 1,
		LayoutOrder = layoutOrder,
	}, parent)

	new("TextLabel", {
		Size = UDim2.new(1, -60, 0, 18),
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamMedium,
		TextSize = 13,
		TextColor3 = Color3.fromRGB(225, 225, 232),
		TextXAlignment = Enum.TextXAlignment.Left,
		Text = labelText,
	}, row)

	local valueLabel = new("TextLabel", {
		Size = UDim2.new(0, 60, 0, 18),
		Position = UDim2.new(1, -60, 0, 0),
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBold,
		TextSize = 13,
		TextColor3 = Color3.fromRGB(120, 180, 255),
		TextXAlignment = Enum.TextXAlignment.Right,
		Text = "0",
	}, row)

	local track = new("Frame", {
		Size = UDim2.new(1, 0, 0, 6),
		Position = UDim2.new(0, 0, 0, 28),
		BackgroundColor3 = Color3.fromRGB(50, 52, 62),
		BorderSizePixel = 0,
	}, row)
	new("UICorner", { CornerRadius = UDim.new(1, 0) }, track)

	local fill = new("Frame", {
		Size = UDim2.new(0, 0, 1, 0),
		BackgroundColor3 = Color3.fromRGB(90, 150, 255),
		BorderSizePixel = 0,
	}, track)
	new("UICorner", { CornerRadius = UDim.new(1, 0) }, fill)

	local handle = new("Frame", {
		Size = UDim2.new(0, 14, 0, 14),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0, 0, 0.5, 0),
		BackgroundColor3 = Color3.fromRGB(245, 245, 250),
		BorderSizePixel = 0,
	}, track)
	new("UICorner", { CornerRadius = UDim.new(1, 0) }, handle)

	local dragging = false

	local function setValue(v)
		local clamped = math.clamp(v, minValue, maxValue)
		local percent = (clamped - minValue) / (maxValue - minValue)
		fill.Size = UDim2.new(percent, 0, 1, 0)
		handle.Position = UDim2.new(percent, 0, 0.5, 0)
		valueLabel.Text = tostring(math.floor(clamped + 0.5))
		if onChanged then onChanged(clamped) end
	end

	local function updateFromInput(input)
		local relativeX = input.Position.X - track.AbsolutePosition.X
		local percent = math.clamp(relativeX / math.max(track.AbsoluteSize.X, 1), 0, 1)
		setValue(minValue + percent * (maxValue - minValue))
	end

	track.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			updateFromInput(input)
		end
	end)

	handle.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch) then
			updateFromInput(input)
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)

	setValue(defaultValue)
	return setValue
end

